# Compose interpolation values. Copy to .env; the repository ignore rules keep
# the real file out of Git. Always replace the JWT example before starting.
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_PORT=8080
MONGO_URI=mongodb://mongo:27017/demo
ANALYTICS_TIMEZONE=Asia/Bangkok
DETECTOR_MODEL=yolov8s

# Used only with the optional standalone-ai Compose profile. Prefer an RTSP URL
# reachable from the container; camera credentials are secrets and stay in .env.
AI_SOURCE=rtsp://username:password@camera-host/path

# Leave empty for same-origin browser requests through the frontend proxy.
VITE_API_BASE_URL=
